# Copy to .env and fill in the platforms you want to enable:
#   cp .env.example .env
# A platform with missing credentials is skipped and reported as
# "Platform not configured: set <VARS>" in the API response.
# NEVER commit your real .env file.

# --- Application -----------------------------------------------------------
LOG_LEVEL=INFO
# IANA timezone used for the "date"/"time" fields in responses.
TIMEZONE=UTC
HTTP_TIMEOUT_SECONDS=15
PLATFORM_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_SECONDS=0.5
# Anonymously fetch each posted URL to confirm it is publicly accessible.
VERIFY_PUBLIC_ACCESS=true

# --- Mastodon ---------------------------------------------------------------
# Preferences -> Development -> New application (scope: write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky ----------------------------------------------------------------
# Settings -> Privacy and security -> App passwords
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- Telegram ---------------------------------------------------------------
# Create a bot via @BotFather, add it as admin of a PUBLIC channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# --- Discord ----------------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- GitHub Gist ------------------------------------------------------------
# Fine-grained PAT with "Gists: Read and write", or classic PAT with "gist".
GITHUB_TOKEN=

# --- DEV Community (dev.to) -------------------------------------------------
# https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=
DEVTO_TAGS=business,marketing

# --- Hugging Face Hub -------------------------------------------------------
# https://huggingface.co/settings/tokens (write access); create the repo first.
HUGGINGFACE_TOKEN=
HUGGINGFACE_REPO_ID=your-username/announcements
HUGGINGFACE_REPO_TYPE=dataset
